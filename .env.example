# ========================================
# 🔐 VARIABLES D'ENVIRONNEMENT - MON FOOT
# ========================================
# Copiez ce fichier en .env et remplissez les valeurs

# ========================================
# 📊 BASE DE DONNÉES (PostgreSQL)
# ========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Exemple local: postgresql://postgres:password@localhost:5432/monfoot
# Exemple cloud: postgresql://user:pass@db.example.com:5432/production
DATABASE_URL="postgresql://user:password@localhost:5432/monfoot"

# ========================================
# 🔴 REDIS (Cache)
# ========================================
# Upstash Redis (recommandé): https://upstash.com/
# Format: your-redis-instance.upstash.io
URL_REDIS="your-redis-url.upstash.io"
PASSWORD_REDIS="your-redis-password"

# ========================================
# 🔒 NEXTAUTH (Authentification)
# ========================================
# URL de l'application (important pour OAuth)
# Dev: http://localhost:3000
# Prod: https://votre-domaine.com
NEXTAUTH_URL="http://localhost:3000"

# Secret pour signer les tokens JWT
# Générer avec: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-chars"

# ========================================
# 🔐 GOOGLE OAUTH
# ========================================
# Obtenir sur: https://console.cloud.google.com/
# 1. Créer un projet
# 2. Activer Google+ API
# 3. Créer des identifiants OAuth 2.0
# 4. Ajouter URI de redirection: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ========================================
# ⚽ FOOTBALL DATA API (Recommandé)
# ========================================
# S'inscrire sur: https://www.football-data.org/client/register
# Plan gratuit: Illimité/jour, 10 requêtes/minute
# 12 compétitions gratuites (World Cup, Champions League, ligues majeures)
# Clé API disponible par email après inscription
FOOTBALL_DATA_API_KEY="your-football-data-api-key"

# ========================================
# ⚽ API FOOTBALL (RapidAPI) - ANCIEN (Optionnel)
# ========================================
# Gardé pour compatibilité, mais Football-Data est recommandé
# S'inscrire sur: https://rapidapi.com/api-sports/api/api-football
# Plan gratuit: 100 requêtes/jour
API_FOOTBALL_KEY="your-rapidapi-key"

# ========================================
# 🌍 ENVIRONNEMENT
# ========================================
# "development" ou "production"
NODE_ENV="development"
